---
const title = 'Technology assessment track deferred';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.png" />
  </head>
  <body>
    <main>
      <p class="eyebrow">Technology Maturity Platform</p>
      <h1>This assessment track is being refined.</h1>
      <p>The current assessment is preserved as a future in-depth advisory track. The simpler executive experience is being designed separately.</p>
      <p><a href="/#contact">Contact Zach to discuss your technology priorities.</a></p>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #080a0d; color: #f4f1ea; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  main { max-width: 40rem; padding: 2rem; }
  .eyebrow { color: #d8ff68; text-transform: uppercase; letter-spacing: .12em; font-size: .75rem; }
  h1 { max-width: 35rem; font-size: clamp(2.5rem, 8vw, 5rem); line-height: .98; margin: 0 0 1.5rem; }
  p { max-width: 36rem; color: #b8b4ac; font-size: 1.1rem; line-height: 1.6; }
  a { color: #d8ff68; }
</style>
