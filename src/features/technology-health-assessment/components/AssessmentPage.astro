---
import { assessmentCategories, assessmentQuestions } from '../index';
import { activeAssessmentVersion, createLegacyFindingRecords } from '../methodology/index.ts';
import AssessmentLanding from './AssessmentLanding.astro';
import BusinessProfileWizard from './BusinessProfileWizard.astro';

type PageKind = 'landing' | 'start' | 'questionnaire' | 'results' | 'report';

const { page = 'landing' } = Astro.props as { page?: PageKind };
const title = page === 'landing' ? 'Technology Health Assessment' : `Technology Health Assessment | ${page[0].toUpperCase()}${page.slice(1)}`;
const legacyFindingRecords = createLegacyFindingRecords(activeAssessmentVersion.legacyQuestionSet.questions);
const methodologyFindings = activeAssessmentVersion.findings.map((finding) => ({
  ...finding,
  recommendations: finding.recommendationIds
    .map((recommendationId) => activeAssessmentVersion.recommendations.find((recommendation) => recommendation.id === recommendationId))
    .filter((recommendation): recommendation is NonNullable<typeof recommendation> => Boolean(recommendation)),
  standards: activeAssessmentVersion.standardMappings
    .filter((mapping) => mapping.capabilityId === finding.capabilityId)
    .map((mapping) => {
      const standard = activeAssessmentVersion.standards.find((item) => item.id === mapping.standardId);
      return { name: standard?.name ?? mapping.standardId, reference: mapping.reference };
    }),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Complete a structured Technology Health Assessment and receive a preliminary Technology Health Report." />
    <link rel="icon" href="/favicon.png" />
  </head>
  <body data-assessment-page={page}>
    <header class="assessment-nav print-hidden">
      <a class="brand" href="/"><span>ZQ</span><small>Zach Quintana</small></a>
      <nav aria-label="Assessment navigation">
        <a href="/assessment">Overview</a>
        <a href="/assessment/start">Start</a>
        <a href="/assessment/questionnaire">Questionnaire</a>
        <a href="/assessment/results">Results</a>
      </nav>
    </header>

    <main id="assessment-root" class="assessment-shell">
      {page === 'landing' && <AssessmentLanding />}
      {page === 'start' && <BusinessProfileWizard />}
      <noscript>This assessment requires JavaScript so it can save progress locally and calculate your report.</noscript>
    </main>

    <script type="application/json" id="assessment-categories" set:html={JSON.stringify(assessmentCategories)}></script>
    <script type="application/json" id="assessment-questions" set:html={JSON.stringify(assessmentQuestions)}></script>
    <script type="application/json" id="assessment-methodology-findings" set:html={JSON.stringify(methodologyFindings)}></script>
    <script type="application/json" id="assessment-legacy-findings" set:html={JSON.stringify(legacyFindingRecords)}></script>
    <script>
      import { evaluateFindingDefinition } from '../methodology/findings.ts';
      import { calculatePriorityScore, calculateScores, getMaturityLabel, scoreQuestion } from '../lib/scoring-core.ts';

      const maturityLabel = getMaturityLabel;

      const categories = JSON.parse(document.querySelector('#assessment-categories').textContent);
      const questions = JSON.parse(document.querySelector('#assessment-questions').textContent);
      const methodologyFindings = JSON.parse(document.querySelector('#assessment-methodology-findings').textContent);
      const legacyFindingRecords = JSON.parse(document.querySelector('#assessment-legacy-findings').textContent);
      const root = document.querySelector('#assessment-root');
      const page = document.body.dataset.assessmentPage;
      const storageKey = 'technology-health-assessment:v1';
      const version = 'mvp-1';

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[char]));
      const track = (eventName, metadata = {}) => window.dispatchEvent(new CustomEvent('assessment:event', { detail: { eventName, metadata } }));

      function parseAssessment(raw) {
        if (!raw) return null;
        try {
          const parsed = JSON.parse(raw);
          if (!parsed || parsed.version !== version || !parsed.assessmentId || !parsed.businessProfile || !parsed.answers) return null;
          return parsed;
        } catch {
          return null;
        }
      }

      function loadState() {
        return parseAssessment(localStorage.getItem(storageKey));
      }

      function createState(profile = {}) {
        const now = new Date().toISOString();
        return {
          assessmentId: `tha-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`,
          version,
          startedAt: now,
          lastUpdatedAt: now,
          status: 'in-progress',
          businessProfile: { businessName: '', respondentName: '', respondentEmail: '', ...profile },
          answers: {},
          currentCategoryId: categories[0].id,
        };
      }

      function saveState(state) {
        const next = { ...state, lastUpdatedAt: new Date().toISOString() };
        localStorage.setItem(storageKey, JSON.stringify(next));
        return next;
      }

      function generateMethodologyFindings(answers) {
        return methodologyFindings.filter((finding) => evaluateFindingDefinition(finding, answers)).map((finding) => {
          const conditionQuestionIds = [...new Set(finding.conditions.map((condition) => condition.questionId))];
          const relatedQuestions = questions.filter((question) => conditionQuestionIds.includes(question.id));
          const relatedScores = relatedQuestions.map((question) => scoreQuestion(question, answers[question.id]));
          const primaryQuestion = relatedQuestions[0] ?? questions.find((question) => question.capabilityId === finding.capabilityId) ?? questions[0];
          const category = categories.find((item) => item.id === primaryQuestion?.categoryId);
          const maturityScore = relatedScores.length ? relatedScores.reduce((total, score) => total + score.maturityScore, 0) / relatedScores.length : 0;
          const confidence = relatedScores.length ? relatedScores.reduce((total, score) => total + score.confidence, 0) / relatedScores.length : 0;
          const critical = finding.severity === 'critical';
          const calculatedPriority = calculatePriorityScore({ ...primaryQuestion, severity: finding.severity }, maturityScore, category?.weight ?? 1);
          const priorityLevel = critical ? 'critical' : calculatedPriority >= 240 ? 'high' : calculatedPriority >= 120 ? 'medium' : 'low';
          const timeframe = priorityLevel === 'critical' ? 'Immediate Attention' : priorityLevel === 'high' ? 'Next 30 Days' : priorityLevel === 'medium' ? 'Next 90 Days' : 'Longer-Term Improvements';
          const recommendation = finding.recommendations[0];
          return {
            id: `finding-${finding.id}`,
            questionId: primaryQuestion?.id ?? conditionQuestionIds[0],
            categoryId: primaryQuestion?.categoryId ?? 'technology-operations',
            title: finding.title,
            businessImpact: finding.businessImpact,
            currentMaturity: maturityScore,
            recommendedAction: recommendation?.actions?.join(' ') ?? recommendation?.summary ?? 'Review this finding with a technology advisor.',
            priorityScore: calculatedPriority,
            priorityLevel,
            timeframe,
            standards: finding.standards,
            requiresVerification: confidence < 0.65 || relatedScores.some((score) => score.unknown),
            critical,
          };
        });
      }

      function generateLegacyFindings(answers) {
        return legacyFindingRecords.filter((record) => evaluateFindingDefinition(record.finding, answers)).map((record) => {
          const question = record.question;
          const answer = answers[question.id];
          const score = scoreQuestion(question, answer);
          const category = categories.find((item) => item.id === question.categoryId);
          const selected = Array.isArray(answer?.value) ? answer.value : [answer?.value];
          const optionCritical = question.criticalFindingRule?.optionIds?.some((id) => selected.includes(id));
          const maturityCritical = typeof question.criticalFindingRule?.maturityAtOrBelow === 'number' && score.maturityScore <= question.criticalFindingRule.maturityAtOrBelow;
          const critical = Boolean(optionCritical || maturityCritical);
          const calculatedPriority = calculatePriorityScore(question, score.maturityScore, category?.weight ?? 1);
          const priorityLevel = critical ? 'critical' : calculatedPriority >= 240 ? 'high' : calculatedPriority >= 120 ? 'medium' : 'low';
          const timeframe = priorityLevel === 'critical' ? 'Immediate Attention' : priorityLevel === 'high' ? 'Next 30 Days' : priorityLevel === 'medium' ? 'Next 90 Days' : 'Longer-Term Improvements';
          return {
            id: `finding-${question.id}`,
            questionId: question.id,
            categoryId: question.categoryId,
            title: critical ? question.criticalFindingRule?.findingTitle ?? record.recommendation.title : record.recommendation.title,
            businessImpact: record.finding.businessImpact,
            currentMaturity: score.maturityScore,
            recommendedAction: record.recommendation.action,
            priorityScore: calculatedPriority,
            priorityLevel,
            timeframe,
            standards: question.standards,
            requiresVerification: score.confidence < 0.65 || score.unknown,
            critical,
          };
        });
      }

      function generateFindings(answers) {
        const modularFindings = generateMethodologyFindings(answers);
        const legacyFindings = generateLegacyFindings(answers);
        return [...modularFindings, ...legacyFindings].sort((a, b) => Number(b.critical) - Number(a.critical) || b.priorityScore - a.priorityScore);
      }

      function calculateAssessmentScores(answers) {
        const findings = generateFindings(answers);
        const findingsByCategory = findings.reduce((counts, finding) => ({ ...counts, [finding.categoryId]: (counts[finding.categoryId] ?? 0) + 1 }), {});
        return { ...calculateScores(answers, findingsByCategory, questions, categories), findings };
      }

      function getStrengths(answers) {
        return questions.flatMap((question) => {
          const score = scoreQuestion(question, answers[question.id]);
          if (!score.applicable || score.maturityScore < 4) return [];
          return [{ question, score }];
        }).slice(0, 5);
      }

      function setupLanding() {
        const resumeLink = document.querySelector('[data-resume-link]');
        if (resumeLink && loadState()) resumeLink.hidden = false;
      }

      function setupStart() {
        let state = loadState() ?? createState();
        const form = document.querySelector('#profile-form');
        const backButton = document.querySelector('#profile-back');
        const nextButton = document.querySelector('#profile-next');
        const error = document.querySelector('#profile-error');
        if (!form || !backButton || !nextButton || !error) return;

        Object.entries(state.businessProfile ?? {}).forEach(([name, value]) => {
          const control = form.elements.namedItem(name);
          if (control && 'value' in control) control.value = value ?? '';
        });

        let activeStep = 0;

        const saveProfileProgress = () => {
          const formData = new FormData(form);
          const nextProfile = Object.fromEntries(formData.entries());
          state = saveState({ ...state, businessProfile: nextProfile, status: 'in-progress' });
        };

        const showStep = (step) => {
          activeStep = Math.max(0, Math.min(3, step));
          document.querySelectorAll('[data-profile-step]').forEach((section) => section.classList.toggle('is-active', Number(section.dataset.profileStep) === activeStep));
          document.querySelectorAll('[data-step-jump]').forEach((button) => button.classList.toggle('is-active', Number(button.dataset.stepJump) === activeStep));
          backButton.textContent = activeStep === 0 ? 'Back to overview' : 'Back';
          nextButton.textContent = activeStep === 3 ? 'Continue to assessment' : 'Continue';
          error.textContent = '';
        };

        const finishProfile = () => {
          const formData = new FormData(form);
          const nextProfile = Object.fromEntries(formData.entries());
          const missing = ['businessName', 'respondentName', 'respondentEmail'].filter((key) => !String(nextProfile[key] ?? '').trim());
          if (missing.length) {
            showStep(0);
            error.textContent = 'Please complete business name, respondent name, and respondent email.';
            return;
          }
          const next = saveState({ ...state, businessProfile: nextProfile, status: 'in-progress' });
          track('Business profile completed', { assessmentId: next.assessmentId });
          location.href = '/assessment/questionnaire';
        };

        nextButton.addEventListener('click', () => {
          saveProfileProgress();
          if (activeStep === 3) finishProfile(); else showStep(activeStep + 1);
        });

        backButton.addEventListener('click', () => {
          saveProfileProgress();
          if (activeStep === 0) location.href = '/assessment'; else showStep(activeStep - 1);
        });

        document.querySelectorAll('[data-step-jump]').forEach((button) => button.addEventListener('click', () => {
          saveProfileProgress();
          showStep(Number(button.dataset.stepJump));
        }));

        showStep(0);
      }

      function renderQuestionnaire() {
        const state = loadState();
        if (!state) { location.href = '/assessment/start'; return; }
        let index = Math.max(0, categories.findIndex((category) => category.id === (state.currentCategoryId ?? categories[0].id)));
        const renderCategory = () => {
          const category = categories[index];
          const categoryQuestions = questions.filter((question) => question.categoryId === category.id);
          root.innerHTML = `<section class="page-heading"><p class="kicker">Section ${index + 1} of ${categories.length}</p><h1>${index + 1}. ${escapeHtml(category.name)}</h1><p class="lede">${escapeHtml(category.businessExplanation)}</p><div class="progress"><span style="width:${((index + 1) / categories.length) * 100}%"></span></div></section><form class="question-form" id="question-form">${categoryQuestions.map((question, questionIndex) => questionHtml(question, state.answers[question.id], index + 1, questionIndex + 1)).join('')}<div class="actions"><button class="button ghost" type="button" id="back-step">Back</button><button class="button primary" type="submit">${index === categories.length - 1 ? 'Complete assessment' : 'Save and continue'}</button><button class="button danger" type="button" id="restart">Restart</button></div></form>`;
          document.querySelectorAll('[data-answer-option]').forEach((option) => {
            option.addEventListener('change', (event) => {
              const questionId = event.target.dataset.answerOption;
              document.querySelectorAll(`input[name="${questionId}__status"]`).forEach((statusControl) => {
                statusControl.checked = false;
              });
            });
          });
          document.querySelector('#back-step').addEventListener('click', () => {
            if (index === 0) location.href = '/assessment/start'; else { index -= 1; state.currentCategoryId = categories[index].id; saveState(state); renderCategory(); }
          });
          document.querySelector('#restart').addEventListener('click', () => {
            if (confirm('Restart this assessment and clear saved progress?')) { localStorage.removeItem(storageKey); location.href = '/assessment/start'; }
          });
          document.querySelector('#question-form').addEventListener('submit', (event) => {
            event.preventDefault();
            const data = new FormData(event.currentTarget);
            categoryQuestions.forEach((question) => {
              const status = data.get(`${question.id}__status`);
              const evidenceLevel = data.get(`${question.id}__evidence`) || 'self-reported';
              const value = question.responseType === 'multi-choice' ? data.getAll(question.id) : data.get(question.id);
              state.answers[question.id] = { questionId: question.id, value, isUnknown: status === 'unknown', isNotApplicable: status === 'na', evidenceLevel, notes: data.get(`${question.id}__notes`) || '' };
            });
            track('Category completed', { categoryId: category.id });
            if (index === categories.length - 1) {
              state.status = 'completed';
              saveState(state);
              track('Assessment completed', { assessmentId: state.assessmentId });
              location.href = '/assessment/results';
            } else {
              index += 1;
              state.currentCategoryId = categories[index].id;
              saveState(state);
              track('Category started', { categoryId: state.currentCategoryId });
              renderCategory();
              root.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          });
        };
        renderCategory();
      }

      function questionHtml(question, answer = {}, sectionNumber, questionNumber) {
        const status = answer.isUnknown ? 'unknown' : answer.isNotApplicable ? 'na' : 'answered';
        return `<fieldset class="question-card"><legend><span class="question-number">${sectionNumber}.${questionNumber}</span>${escapeHtml(question.prompt)}</legend>${question.description ? `<p>${escapeHtml(question.description)}</p>` : ''}<div class="standards">${question.standards.map((standard) => `<span>${escapeHtml(standard.name)}</span>`).join('')}</div>${question.allowUnknown || question.allowNotApplicable ? `<div class="answer-status" aria-label="Special answer options for question ${sectionNumber}.${questionNumber}">${question.allowUnknown ? `<label><input type="radio" name="${question.id}__status" value="unknown" ${status === 'unknown' ? 'checked' : ''}> Not sure</label>` : ''}${question.allowNotApplicable ? `<label><input type="radio" name="${question.id}__status" value="na" ${status === 'na' ? 'checked' : ''}> Not applicable</label>` : ''}</div>` : ''}<div class="option-list">${(question.options ?? []).map((option) => `<label><input data-answer-option="${question.id}" type="${question.responseType === 'multi-choice' ? 'checkbox' : 'radio'}" name="${question.id}" value="${option.id}" ${Array.isArray(answer.value) ? answer.value.includes(option.id) ? 'checked' : '' : answer.value === option.id ? 'checked' : ''}> <span>${escapeHtml(option.label)}</span>${option.description ? `<small>${escapeHtml(option.description)}</small>` : ''}</label>`).join('')}</div><label class="field"><span class="field-label">Evidence level</span><select name="${question.id}__evidence"><option value="self-reported" ${answer.evidenceLevel === 'self-reported' || answer.evidenceLevel === 'automatically-verified' || !answer.evidenceLevel ? 'selected' : ''}>Unverified</option><option value="documentation-reviewed" ${answer.evidenceLevel === 'documentation-reviewed' ? 'selected' : ''}>Documentation reviewed</option><option value="manually-verified" ${answer.evidenceLevel === 'manually-verified' ? 'selected' : ''}>Manually verified</option></select></label><label class="field"><span class="field-label">Optional notes</span><textarea name="${question.id}__notes" rows="2">${escapeHtml(answer.notes || '')}</textarea></label></fieldset>`;
      }

      function renderResults(printMode = false) {
        const state = loadState();
        if (!state) { location.href = '/assessment/start'; return; }
        const results = calculateAssessmentScores(state.answers);
        const strengths = getStrengths(state.answers);
        const criticalCount = results.findings.filter((finding) => finding.critical).length;
        const highCount = results.findings.filter((finding) => finding.priorityLevel === 'high').length;
        const grouped = ['Immediate Attention', 'Next 30 Days', 'Next 90 Days', 'Longer-Term Improvements'].map((group) => [group, results.findings.filter((finding) => finding.timeframe === group)]);
        root.innerHTML = `<section class="page-heading report-heading"><p class="kicker">Preliminary Technology Health Report</p><h1>${escapeHtml(state.businessProfile.businessName || 'Technology Health Assessment')}</h1><p class="lede">Assessment ID: ${escapeHtml(state.assessmentId)}</p><div class="actions print-hidden"><button class="button primary" onclick="window.print()">Print report</button><a class="button secondary" href="/assessment/report">Printable view</a><a class="button ghost" href="/assessment/questionnaire">Update answers</a></div></section><section class="score-grid"><article class="score-card major"><span>Technology Health Score</span><strong>${results.overallScore}</strong><em>${maturityLabel(results.overallScore)}</em></article><article class="score-card"><span>Assessment confidence</span><strong>${Math.round(results.overallConfidence * 100)}%</strong><em>Evidence quality</em></article><article class="score-card"><span>Critical risks</span><strong>${criticalCount}</strong><em>Immediate attention</em></article><article class="score-card"><span>High-priority recommendations</span><strong>${highCount}</strong><em>Next 30 days</em></article></section><section class="panel"><h2>Executive Summary</h2><p>This preliminary assessment indicates a ${maturityLabel(results.overallScore).toLowerCase()} technology posture. Confidence is shown separately because low confidence means more evidence is needed, not necessarily that technology is unhealthy.</p><p class="muted">This report is advisory guidance, not a certification, legal opinion, compliance attestation, penetration test, or formal security audit.</p></section><section class="category-summary"><h2>Category Summary</h2>${categories.map((category) => { const score = results.categoryScores.find((item) => item.categoryId === category.id); return `<article><div><h3>${escapeHtml(category.name)}</h3><p>${escapeHtml(category.shortDescription)}</p></div><strong>${score?.score ?? 0}</strong><span>${maturityLabel(score?.score ?? 0)} · ${category.weight}% weight · ${Math.round((score?.confidence ?? 0) * 100)}% confidence · ${score?.findings ?? 0} findings</span></article>`; }).join('')}</section><section class="findings"><h2>Priority Findings</h2>${grouped.map(([group, findings]) => `<div class="finding-group"><h3>${group}</h3>${findings.length ? findings.map(findingHtml).join('') : '<p class="muted">No findings in this group.</p>'}</div>`).join('')}</section><section class="panel"><h2>Strengths</h2>${strengths.length ? `<ul>${strengths.map((item) => `<li>${escapeHtml(item.question.prompt)} <span class="muted">(${Math.round(item.score.confidence * 100)}% confidence)</span></li>`).join('')}</ul>` : '<p class="muted">Strengths will appear as more answers are verified at higher maturity levels.</p>'}</section><section class="panel cta print-hidden"><h2>Review these results with a Fractional Technology Partner.</h2><p>Use this preliminary report to prioritize the next conversation about risk, resilience, cost, and practical next steps.</p><form class="consult-form" id="consult-form"><input name="name" placeholder="Name" value="${escapeHtml(state.businessProfile.respondentName)}"><input name="email" placeholder="Email" value="${escapeHtml(state.businessProfile.respondentEmail)}"><input name="company" placeholder="Company" value="${escapeHtml(state.businessProfile.businessName)}"><textarea name="message" placeholder="Optional message" rows="3"></textarea><button class="button primary" type="submit">Request consultation</button></form></section>`;
        document.querySelector('#consult-form')?.addEventListener('submit', (event) => {
          event.preventDefault();
          const form = new FormData(event.currentTarget);
          track('Consultation requested', { assessmentId: state.assessmentId, overallScore: results.overallScore, criticalFindingCount: criticalCount });
          const body = encodeURIComponent(`Assessment ID: ${state.assessmentId}\nOverall score: ${results.overallScore}\nCritical findings: ${criticalCount}\n\n${form.get('message') || ''}`);
          location.href = `mailto:zach.quintana@gmail.com?subject=Technology Health Assessment consultation&body=${body}`;
        });
        if (printMode) track('Report viewed', { assessmentId: state.assessmentId });
      }

      function findingHtml(finding) {
        return `<article class="finding ${finding.priorityLevel}"><h4>${escapeHtml(finding.title)}</h4><p><strong>Business impact:</strong> ${escapeHtml(finding.businessImpact)}</p><p><strong>Recommended action:</strong> ${escapeHtml(finding.recommendedAction)}</p><p><strong>Current maturity:</strong> ${finding.currentMaturity.toFixed(1)} / 5 · <strong>Priority:</strong> ${escapeHtml(finding.priorityLevel)}${finding.requiresVerification ? ' · Further verification recommended' : ''}</p><div class="standards">${finding.standards.map((standard) => `<span>${escapeHtml(standard.name)}</span>`).join('')}</div></article>`;
      }

      if (page === 'landing') setupLanding();
      if (page === 'start') setupStart();
      if (page === 'questionnaire') renderQuestionnaire();
      if (page === 'results') renderResults(false);
      if (page === 'report') renderResults(true);
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #080a0d;
    --bg-soft: #10141a;
    --panel: rgba(255, 255, 255, 0.06);
    --panel-strong: rgba(255, 255, 255, 0.1);
    --text: #f4f1ea;
    --muted: #a9a39a;
    --line: rgba(244, 241, 234, 0.16);
    --accent: #d8ff68;
    --accent-ink: #161b0b;
    --danger: #ff8b8b;
    --max: 1160px;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-width: 320px;
    background:
      radial-gradient(circle at top left, rgba(216, 255, 104, 0.16), transparent 28rem),
      radial-gradient(circle at 85% 8%, rgba(114, 129, 255, 0.12), transparent 24rem),
      linear-gradient(180deg, var(--bg), var(--bg-soft));
    color: var(--text);
    line-height: 1.6;
  }

  a { color: inherit; text-decoration: none; }
  button, input, textarea, select { font: inherit; }
  h1, h2, h3, h4, p { margin-top: 0; }

  .assessment-nav {
    position: sticky;
    top: 0;
    z-index: 5;
    width: min(var(--max), calc(100% - 32px));
    margin: 14px auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(18px);
  }

  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 850; }
  .brand span { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); letter-spacing: -0.09em; }
  .brand small, .muted { color: var(--muted); }
  nav { display: flex; flex-wrap: wrap; gap: 8px; }
  nav a { color: var(--muted); padding: 8px 10px; border-radius: 999px; }
  nav a:hover, nav a:focus-visible { background: var(--panel); color: var(--text); outline: 1px solid var(--line); }

  .assessment-shell {
    width: min(var(--max), calc(100% - 32px));
    margin: 0 auto;
    padding: 42px 0 90px;
  }

  .assessment-hero,
  .page-heading {
    padding: 42px 0 28px;
  }

  .hero-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 36px;
    align-items: end;
    max-width: none;
    margin-bottom: 16px;
    border: 1px solid var(--line);
    border-radius: 36px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.045));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.3);
    padding: clamp(28px, 5vw, 58px);
    overflow: hidden;
  }

  .focused-hero {
    min-height: 430px;
  }

  .hero-copy { max-width: 790px; }

  .hero-summary {
