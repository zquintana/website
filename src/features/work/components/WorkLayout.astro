---
import ConsentAnalytics from '../../analytics/components/ConsentAnalytics.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://www.zachquintana.com').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://www.zachquintana.com/images/profile.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.zachquintana.com/images/profile.jpg" />
    <link rel="icon" href="/favicon.png" />
  </head>
  <body>
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="brand" href="/" aria-label="Zach Quintana home"><span>ZQ</span><small>Zach Quintana</small></a>
      <div class="nav-links">
        <a href="/work/">Work</a>
        <a href="/documents/zach-quintana-staff-principal-resume.pdf" target="_blank" rel="noopener noreferrer" aria-label="View resume PDF (opens in a new tab)">Resume</a>
        <a href="/consulting/">Consulting</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </div>
    </nav>

    <main class="work-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Zach Quintana</p>
      <div>
        <a href="/work/">Work</a>
        <a href="/documents/zach-quintana-staff-principal-resume.pdf" target="_blank" rel="noopener noreferrer" aria-label="View resume PDF (opens in a new tab)">Resume</a>
        <a href="/consulting/">Consulting</a>
        <a href="/#contact">Contact</a>
        <a href="https://www.linkedin.com/in/zachary-quintana-3bb77b68/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="/health-check">Technology Health Check</a>
      </div>
    </footer>
    <ConsentAnalytics />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #080a0d;
    --bg-soft: #10141a;
    --panel: rgba(255, 255, 255, 0.06);
    --panel-strong: rgba(255, 255, 255, 0.1);
    --text: #f4f1ea;
    --muted: #a9a39a;
    --line: rgba(244, 241, 234, 0.16);
    --accent: #d8ff68;
    --accent-soft: rgba(216, 255, 104, 0.16);
    --accent-ink: #161b0b;
    --shadow: 0 24px 80px rgba(0, 0, 0, 0.36);
    --max: 1160px;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    min-width: 320px;
    margin: 0;
    background:
      radial-gradient(circle at top left, rgba(216, 255, 104, 0.16), transparent 28rem),
      linear-gradient(180deg, var(--bg), var(--bg-soft) 58%, var(--bg));
    color: var(--text);
    line-height: 1.6;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: '';
    opacity: 0.28;
    background-image: linear-gradient(rgba(244, 241, 234, 0.11) 1px, transparent 1px), linear-gradient(90deg, rgba(244, 241, 234, 0.11) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, #000, transparent 72%);
  }

  a { color: inherit; text-decoration: none; }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .site-nav,
  .site-footer,
  .work-shell {
    width: min(var(--max), calc(100% - 32px));
    margin-inline: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 14px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 10px;
    height: 44px;
    padding: 4px 13px 4px 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 850;
  }

  .brand span {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    letter-spacing: -0.09em;
  }

  .brand small { color: var(--muted); font-size: 0.88rem; }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
  }

  .nav-links a {
    padding: 9px 12px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .nav-links a:hover,
  .site-footer a:hover { color: var(--text); }

  .work-shell { padding: 92px 0 112px; }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .breadcrumb a { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 4px; }

  .work-hero { max-width: 820px; margin-bottom: 72px; }

  .eyebrow,
  .section-kicker {
    margin: 0 0 16px;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p { margin-top: 0; }

  h1 {
    max-width: 900px;
    margin-bottom: 24px;
    font-size: clamp(2.7rem, 6vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  h2 { margin-bottom: 14px; font-size: clamp(1.8rem, 3vw, 2.8rem); line-height: 1.05; letter-spacing: -0.045em; }
  h3 { margin-bottom: 10px; font-size: 1.15rem; line-height: 1.15; }

  .summary { max-width: 760px; color: var(--muted); font-size: clamp(1.08rem, 1.8vw, 1.3rem); }

  .outcome-card,
  .case-section,
  .next-work {
    border: 1px solid var(--line);
    border-radius: 28px;
    background: linear-gradient(145deg, var(--panel-strong), var(--panel));
    box-shadow: var(--shadow);
  }

  .outcome-card { margin-bottom: 56px; padding: clamp(24px, 4vw, 42px); }

  .outcome-card strong { display: block; margin-bottom: 8px; color: var(--accent); font-size: clamp(1.7rem, 3.5vw, 3rem); line-height: 1; letter-spacing: -0.05em; }

  .outcome-card p,
  .case-section p,
  .case-section li,
  .next-work p { color: var(--muted); }

  .case-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr); gap: 16px; align-items: start; }

  .case-section { padding: clamp(24px, 4vw, 38px); }

  .case-section + .case-section { margin-top: 16px; }

  .case-section ul { display: grid; gap: 12px; margin: 0; padding-left: 1.2rem; }

  .case-aside { display: grid; gap: 16px; position: sticky; top: 24px; }

  .case-aside .case-section { background: rgba(216, 255, 104, 0.06); }

  .tag-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }

  .tag-list li { padding: 7px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--text); font-size: 0.86rem; }

  .next-work { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 72px; padding: 26px 30px; }

  .next-work h2 { margin-bottom: 0; font-size: clamp(1.45rem, 2.8vw, 2.2rem); }

  .other-work-links { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }

  .other-work-links a,
  .text-link { color: var(--text); font-weight: 800; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 5px; }

  .opportunity-note { max-width: 260px; margin: 0; color: var(--muted); font-size: 0.94rem; }

  .next-work-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 16px; }

  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 11px 18px; border: 1px solid var(--line); border-radius: 999px; font-weight: 800; }

  .button.primary { border-color: transparent; background: var(--accent); color: var(--accent-ink); }

  .button.secondary { color: var(--text); }

  .button:hover { border-color: var(--accent); transform: translateY(-1px); }

  .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 28px 0 44px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.92rem; }

  .site-footer p { margin-bottom: 0; }

  .site-footer div { display: flex; flex-wrap: wrap; gap: 16px; }

  @media (max-width: 820px) {
    .site-nav { align-items: flex-start; border-radius: 24px; }
    .nav-links { justify-content: flex-start; }
    .case-grid { grid-template-columns: 1fr; }
    .case-aside { position: static; }
  }

  @media (max-width: 640px) {
    .site-nav,
    .site-footer,
    .work-shell { width: min(100% - 24px, var(--max)); }
    .site-nav { flex-direction: column; gap: 10px; }
    .nav-links { width: 100%; justify-content: space-between; }
    .nav-links a { padding-inline: 7px; font-size: 0.84rem; }
    .work-shell { padding: 56px 0 76px; }
    .work-hero { margin-bottom: 48px; }
    .next-work { align-items: flex-start; flex-direction: column; padding: 24px; }
    .next-work-actions { align-items: flex-start; justify-content: flex-start; flex-direction: column; }
    .site-footer { align-items: flex-start; flex-direction: column; padding-bottom: 28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .button { transition: none; }
  }
</style>
