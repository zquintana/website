---
import WorkLayout from '../../features/work/components/WorkLayout.astro';
import { caseStudies } from '../../features/work/data/caseStudies';
---

<WorkLayout
  title="Selected Engineering Work | Zach Quintana"
  description="Case studies covering SaaS modernization, AWS and Kubernetes infrastructure, backend performance, reliability, and difficult production engineering initiatives."
  canonicalPath="/work/"
>
  <section class="work-hero">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Work</span></nav>
    <p class="eyebrow">Selected work</p>
    <h1>Selected engineering work</h1>
    <p class="summary">Most of my work has been performed inside proprietary production systems. These case studies focus on the technical situation, my role, the work performed, and the measurable outcome without exposing confidential implementation details.</p>
    <p class="summary">Where an initiative involved a larger team, I state that directly.</p>
  </section>

  <section aria-labelledby="case-studies-title">
    <h2 id="case-studies-title" class="sr-only">Case studies</h2>
    <div class="work-index-grid">
      {caseStudies.map((caseStudy) => (
        <a class="work-index-card" href={`/work/${caseStudy.slug}/`}>
          <p class="eyebrow">{caseStudy.eyebrow}</p>
          <h2>{caseStudy.title}</h2>
          <p>{caseStudy.summary}</p>
          <p class="card-outcome"><strong>Outcome:</strong> {caseStudy.outcome}</p>
          <p class="card-areas"><strong>Technical areas:</strong> {caseStudy.technologies.join(', ')}</p>
          <span class="read-link">Read case study <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="opportunity-cta" aria-labelledby="opportunity-title">
    <p class="eyebrow">Current opportunities</p>
    <h2 id="opportunity-title">Need someone who can do this kind of work?</h2>
    <p>I'm open to Staff/Principal-level engineering roles and a limited number of high-impact contract engagements.</p>
    <div class="opportunity-actions">
      <a class="button secondary" href="/documents/zach-quintana-staff-principal-resume.pdf" target="_blank" rel="noopener noreferrer" aria-label="View resume PDF (opens in a new tab)">View resume</a>
      <a class="button primary" href="/#contact">Discuss an opportunity</a>
    </div>
  </section>
</WorkLayout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .work-index-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .work-index-card { display: flex; min-height: 360px; flex-direction: column; align-items: flex-start; padding: 28px; border: 1px solid var(--line); border-radius: 28px; background: linear-gradient(145deg, var(--panel-strong), var(--panel)); box-shadow: var(--shadow); }
  .work-index-card:hover { border-color: color-mix(in srgb, var(--accent) 70%, var(--line)); }
  .work-index-card h2 { margin-bottom: 16px; }
  .work-index-card > p:not(.eyebrow) { color: var(--muted); }
  .work-index-card .card-outcome { margin-top: 8px; color: var(--text); }
  .work-index-card .card-areas { margin-top: 0; font-size: 0.92rem; }
  .work-index-card strong { color: var(--text); }
  .read-link { margin-top: auto; color: var(--text); font-weight: 800; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 5px; }
  .opportunity-cta { margin-top: 72px; padding: clamp(26px, 4vw, 42px); border: 1px solid var(--line); border-radius: 28px; background: rgba(216, 255, 104, 0.07); box-shadow: var(--shadow); }
  .opportunity-cta h2 { margin-bottom: 14px; }
  .opportunity-cta > p:not(.eyebrow) { max-width: 680px; color: var(--muted); }
  .opportunity-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  @media (max-width: 900px) { .work-index-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .work-index-grid { grid-template-columns: 1fr; } .work-index-card { min-height: 280px; } }
</style>
