---
import WorkLayout from '../../features/work/components/WorkLayout.astro';
import { caseStudies, getCaseStudy, type CaseStudy } from '../../features/work/data/caseStudies';

interface Props {
  caseStudy: CaseStudy;
}

export function getStaticPaths() {
  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props as Props;
const fallback = getCaseStudy(Astro.params.slug ?? '');
const study = (caseStudy ?? fallback) as CaseStudy | undefined;

if (!study) {
  throw new Error(`Unknown case study: ${Astro.params.slug}`);
}

const otherCaseStudies = caseStudies.filter((caseStudy) => caseStudy.slug !== study.slug);
---

<WorkLayout
  title={study.metadataTitle}
  description={study.summary}
  canonicalPath={`/work/${study.slug}/`}
>
  <article>
    <header class="work-hero">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/work/">Work</a><span aria-hidden="true">/</span><span aria-current="page">{study.title}</span></nav>
      <p class="eyebrow">{study.eyebrow}</p>
      <h1>{study.title}</h1>
      <p class="summary">{study.summary}</p>
    </header>

    <div class="outcome-card">
      <p class="eyebrow">Outcome</p>
      <strong>{study.outcome}</strong>
      <p>{study.result}</p>
    </div>

    <div class="case-grid">
      <div>
        <section class="case-section" aria-labelledby="situation-title">
          <p class="section-kicker">Situation</p>
          <h2 id="situation-title">The system and the situation</h2>
          <p>{study.situation}</p>
        </section>
        <section class="case-section" aria-labelledby="constraints-title">
          <p class="section-kicker">Constraints</p>
          <h2 id="constraints-title">What the work had to respect</h2>
          <ul>
            {study.constraints.map((constraint: string) => <li>{constraint}</li>)}
          </ul>
        </section>
        <section class="case-section" aria-labelledby="technical-work-title">
          <p class="section-kicker">Technical work</p>
          <h2 id="technical-work-title">How the work moved forward</h2>
          <ul>
            {study.technicalWork.map((step: string) => <li>{step}</li>)}
          </ul>
        </section>
        <section class="case-section" aria-labelledby="result-title">
          <p class="section-kicker">Result</p>
          <h2 id="result-title">What changed</h2>
          <p>{study.result}</p>
        </section>
      </div>

      <aside class="case-aside" aria-label="Case study details">
        <section class="case-section">
          <p class="section-kicker">Role</p>
          <p>{study.role}</p>
        </section>
        <section class="case-section">
          <p class="section-kicker">Ownership and collaboration</p>
          <p>{study.ownership}</p>
        </section>
        <section class="case-section">
          <p class="section-kicker">Technologies and areas</p>
          <ul class="tag-list">
            {study.technologies.map((technology: string) => <li>{technology}</li>)}
          </ul>
        </section>
      </aside>
    </div>

    <nav class="next-work" aria-label="More selected work and contact">
      <div class="next-work-heading">
        <p class="eyebrow">Continue exploring</p>
        <h2>See the rest of the selected work.</h2>
      </div>
      <p class="opportunity-note">I'm open to Staff/Principal engineering roles and select high-impact contract engagements.</p>
      <ul class="other-work-links">
        {otherCaseStudies.map((otherCaseStudy) => <li><a href={`/work/${otherCaseStudy.slug}/`}>{otherCaseStudy.title}</a></li>)}
      </ul>
      <div class="next-work-actions">
        <a class="text-link" href="/documents/zach-quintana-staff-principal-resume.pdf" target="_blank" rel="noopener noreferrer" aria-label="View resume PDF (opens in a new tab)">View resume</a>
        <a class="button secondary" href="/#contact">Discuss a role or technical initiative</a>
        <a class="text-link" href="/work/">Back to selected work</a>
      </div>
    </nav>
  </article>
</WorkLayout>
